{
  "cli": {
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "ios-https-qualification": {
      "node": "24.22.2",
      "pnpm": "10.34.9",
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_BUNNY_HTTPS_QUALIFICATION": "1",
        "BUNNY_IOS_HTTPS_QUALIFICATION": "1"
      },
      "ios": {
        "simulator": true,
        "withoutCredentials": true,
        "buildConfiguration": "Release",
        "image": "sdk-57",
        "resourceClass": "medium",
        "config": "ios-https-qualification.yml"
      }
    },
    "ios-https-libcurl-build": {
      "node": "24.22.2",
      "pnpm": "10.34.9",
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "BUNNY_IOS_HTTPS_QUALIFICATION": "1"
      },
      "ios": {
        "simulator": true,
        "withoutCredentials": true,
        "buildConfiguration": "Release",
        "image": "macos-tahoe-26.5-xcode-26.6",
        "resourceClass": "medium",
        "config": "ios-https-libcurl-build.yml"
      }
    }
  }
}
