generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String              @id @db.VarChar(128)
  credential         PasswordCredential?
  vault              VaultState?
  publications       VaultPublication[]
  operations         VaultOperation[]
  devices            Device[]
  emailIdentity      EmailIdentity?
  registration       EmailRegistration?
}

model PasswordCredential {
  accountId String  @id @db.VarChar(128)
  verifier  String
  revision  BigInt  @default(1)
  verifierUpdatedAt DateTime? @default(dbgenerated("statement_timestamp()")) @db.Timestamptz(3)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model EmailIdentity {
  accountId String @id @db.VarChar(128)
  canonical String @unique @db.VarChar(254)
  display String @db.VarChar(254)
  verifiedAt DateTime @db.Timestamptz(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model EmailRegistration {
  id String @id @db.Uuid
  canonical String @db.VarChar(254)
  display String @db.VarChar(254)
  tokenHash Bytes
  createdAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  accountId String? @unique @db.VarChar(128)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([expiresAt])
}

model VaultState {
  accountId                  String           @id @db.VarChar(128)
  vaultId                    String           @db.VarChar(22)
  storageRevision            BigInt
  activePublicationId        String           @db.Uuid
  account                    Account          @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activePublication          VaultPublication @relation(fields: [accountId, vaultId, activePublicationId], references: [accountId, vaultId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([accountId, vaultId])
}

model VaultPublication {
  id                         String       @id @db.Uuid
  accountId                  String       @db.VarChar(128)
  vaultId                    String       @db.VarChar(22)
  cryptographicFormatVersion Int
  generation                 BigInt
  contentRevision            BigInt
  passwordRevision           BigInt
  recoveryRevision           BigInt
  envelopeCredentialRevision BigInt
  bytes                      Bytes
  digest                     Bytes
  account                    Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeFor                  VaultState[]
  @@unique([accountId, vaultId, id])
}

model VaultOperation {
  bootstrap                  InitialBootstrapOperation?
  accountId                  String  @db.VarChar(128)
  operationId                String  @db.Uuid
  kind                       String  @db.VarChar(32)
  expectedStorageRevision    BigInt?
  expectedCredentialRevision BigInt
  fingerprintKeyId           String  @db.VarChar(128)
  fingerprint                Bytes
  status                     String  @db.VarChar(16)
  resultStorageRevision      BigInt?
  resultCredentialRevision   BigInt?
  publicationDigest          Bytes?
  rejectionCode              String? @db.VarChar(32)
  account                    Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([accountId, operationId])
}

model Device {
  bootstrapOperations InitialBootstrapOperation[]
  authorizedAt DateTime? @db.Timestamptz(3)
  id        String    @id @db.Uuid
  accountId String    @db.VarChar(128)
  revokedAt DateTime? @db.Timestamptz(3)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions  Session[]
  @@unique([accountId, id])
}

// The receipt remains the sole source of the terminal outcome, including rejections.
model InitialBootstrapOperation {
  accountId String @db.VarChar(128)
  operationId String @db.Uuid
  deviceId String @db.Uuid
  operation VaultOperation @relation(fields: [accountId, operationId], references: [accountId, operationId], onDelete: Restrict, onUpdate: Restrict, map: "Bootstrap_operation_fkey")
  device Device @relation(fields: [accountId, deviceId], references: [accountId, id], onDelete: Restrict, onUpdate: Restrict, map: "Bootstrap_device_fkey")
  @@id([accountId, operationId])
}

model Session {
  grants ReauthenticationGrant[]
  @@unique([accountId, id, deviceId])
  tokenHash Bytes?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  idleTimeoutMs Int?
  id        String    @id @db.Uuid
  accountId String    @db.VarChar(128)
  deviceId  String    @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([accountId])
  device    Device    @relation(fields: [accountId, deviceId], references: [accountId, id], onDelete: Restrict, onUpdate: Restrict)
}

model ReauthenticationGrant {
  id String @id @db.Uuid
  tokenHash Bytes
  accountId String @db.VarChar(128)
  sessionId String @db.Uuid
  deviceId String @db.Uuid
  kind String @db.VarChar(32)
  operationId String @db.Uuid
  intentHash Bytes
  credentialRevision BigInt
  createdAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  session Session @relation(fields: [accountId, sessionId, deviceId], references: [accountId, id, deviceId], onDelete: Restrict, onUpdate: Restrict)
}

model RegistrationBudget {
  key String @id @db.Char(64)
  startedAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  hits Int
  @@index([expiresAt])
}

model RegistrationLease {
  id String @id @db.Uuid
  kind String @db.VarChar(8)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

model LoginBudget {
  key String @id @db.Char(64)
  startedAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  hits Int
  @@index([expiresAt])
}

model LoginLease {
  id String @id @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}
