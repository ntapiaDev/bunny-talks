{
  "name": "@bunny-talks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && pnpm start",
    "start": "node server.mjs",
    "test:http": "pnpm build && vitest run tests/http",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "node migrate-local.mjs",
    "test:persistence": "vitest run tests/persistence",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "vitest run tests/unit"
  },
  "dependencies": {
    "@bunny-talks/contracts": "workspace:*",
    "@bunny-talks/crypto-backup": "workspace:*",
    "@bunny-talks/validation": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prisma": "7.10.1",
    "smtp-server": "3.21.6"
  }
}
