{
  "expo": {
    "name": "Bunny Talks",
    "slug": "bunny-talks",
    "scheme": "bunnytalks",
    "version": "0.1.0",
    "orientation": "portrait",
    "android": {
      "package": "fr.bunnytalks.mobile"
    },
    "ios": {
      "bundleIdentifier": "fr.bunnytalks.mobile",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store"
    ]
  }
}
