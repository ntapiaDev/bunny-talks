POSTGRES_USER=bunny_local
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=bunny_talks
DATABASE_URL=postgresql://bunny_local:replace_with_local_password@127.0.0.1:55432/bunny_talks
TEST_DATABASE_URL=postgresql://bunny_local:replace_with_local_password@127.0.0.1:55432/bunny_talks_test
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# L'inscription reste indisponible tant que cette configuration n'est pas activée et complète.
REGISTRATION_ENABLED=false
REGISTRATION_SMTP_HOST=
REGISTRATION_SMTP_PORT=465
REGISTRATION_SMTP_SECURE=true
REGISTRATION_SMTP_USER=
REGISTRATION_SMTP_PASSWORD=
REGISTRATION_SMTP_FROM=
# Clé aléatoire serveur de 32 octets, hexadécimale minuscule, identique sur toutes les instances.
REGISTRATION_HMAC_KEY=
REGISTRATION_SMTP_TIMEOUT_MS=2000
REGISTRATION_REQUESTS_PER_SOURCE=10
REGISTRATION_REQUESTS_GLOBALLY=300
REGISTRATION_SENDS_PER_EMAIL=3
REGISTRATION_COOLDOWN_MS=60000
REGISTRATION_COMPLETIONS_PER_SOURCE=20
REGISTRATION_ATTEMPTS_PER_PROOF=10
REGISTRATION_HASHES_PER_MINUTE=20
REGISTRATION_CONCURRENT_REQUESTS=16
REGISTRATION_CONCURRENT_COMPLETIONS=2
